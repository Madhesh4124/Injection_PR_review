# ==============================================================================
# Injection-Robust PR Review Agent - Environment Configuration
# ==============================================================================
# NOTE: This agent runs strictly local, offline, and self-hosted.
# NO cloud-provider dependencies, API keys, or external network calls are required.
# ==============================================================================

# Ollama Endpoint & Model Selection
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:1.5b

# Concurrency & Queue Protection
# Requirement: Limit concurrent Ollama inference requests to 1 by default
OLLAMA_MAX_CONCURRENCY=1
# Requirement: Bounded queue with a maximum of 5 waiting requests before fast-failing
OLLAMA_MAX_QUEUE_SIZE=5

# Wall-Clock Timeout Protection
# Requirement: Configurable request timeouts, defaulting to 120 seconds
OLLAMA_TIMEOUT_SECONDS=120.0

# Transient Failure Retry Configuration
# Maximum total attempts: 2 including initial attempt (1 initial attempt + 1 retry max)
OLLAMA_MAX_RETRIES=1
OLLAMA_BASE_BACKOFF_SECONDS=0.5
OLLAMA_MAX_BACKOFF_SECONDS=5.0
OLLAMA_JITTER_SECONDS=0.25

# Input / Output Size Limits (DoS & Memory Exhaustion Protection)
# Limits enforced before processing prompts or parsing response strings
OLLAMA_MAX_INPUT_BYTES=175000
OLLAMA_MAX_OUTPUT_BYTES=100000

# Canary Telemetry HMAC Key (Required for production deployments)
# Cryptographically secure 32-byte (256-bit) key for deriving 128-bit safe canary IDs.
# Formats accepted:
# - 64-character hexadecimal (e.g. from: openssl rand -hex 32)
# - Base64 string of >= 32 bytes (e.g. from: openssl rand -base64 32)
# - UTF-8 string with length >= 32 bytes
# Deployment requirement: Restrict environment and process access to authorized operators.
# If unset or weaker than 32 bytes, the system fails closed (CanaryKeyConfigurationError).
# CANARY_HMAC_SECRET=replace_with_generated_64_hex_chars_or_base64_secret

